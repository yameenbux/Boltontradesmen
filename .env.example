TRUSTED_PROXY_HOPS=1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
OWNER_LEGAL_NAME=Bolton Vouched (owner name pending)
CONTACT_EMAIL=hello@example.com
# Twilio Lookup (line-type check before a sign-in code is sent). Server only; never NEXT_PUBLIC_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Local/CI only: answers Ofcom drama numbers (07700 900xxx) without calling Twilio
# (900666 = VoIP, 900999 = lookup failure, others = mobile). Other numbers still use the real Lookup. Never set in production.
TWILIO_LOOKUP_STUB=1
