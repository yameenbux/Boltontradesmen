# Local defaults: identical for `npx supabase start` and `npm run stack:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
DEVICE_HASH_SECRET=change-me
# How many trusted proxies append to X-Forwarded-For (Railway: 1). The client IP is that many entries from the right.
TRUSTED_PROXY_HOPS=1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
OWNER_LEGAL_NAME=Bolton Vouched (owner name pending)
CONTACT_EMAIL=hello@example.com
# Twilio Lookup (line-type check before a sign-in code is sent). Server only; never NEXT_PUBLIC_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Local/CI only: answers Ofcom drama numbers (07700 900xxx) without calling Twilio
# (900666 = VoIP, 900999 = lookup failure, others = mobile). Other numbers still use the real Lookup. Never set in production.
TWILIO_LOOKUP_STUB=1
# Supabase "Send SMS" hook (/api/auth/sms-hook): the signing secret Supabase shows for the hook ("v1,whsec_...").
# Local value matches scripts/local-stack/start.sh; production uses the one from the Supabase dashboard.
SUPABASE_SMS_HOOK_SECRET=v1,whsec_bG9jYWwtZHVtbXktc21zLWhvb2stbm90LXNlY3JldCE=
# Twilio Messaging Service the hook sends through (production only).
TWILIO_MESSAGING_SERVICE_SID=
# Local/CI only: the hook "sends" to Ofcom drama numbers (07700 900xxx) without calling Twilio. Never set in production.
TWILIO_SMS_STUB=1
# on = show phone sign-in (needs Twilio, see README). Anything else = off.
SIGN_IN_PHONE=off
# Cloudflare Turnstile on "Email me a code" and the admin sign-in. Leave BOTH empty locally and in CI (no check).
# Production: the site key (public, shown to the browser) and the secret key (server only) from Cloudflare.
# Only one set = email sign-in refuses every request (fail closed).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Google Search Console ownership tag (the content="..." value of the HTML-tag method). Optional; read at build time.
GOOGLE_SITE_VERIFICATION=
# Cloudflare Web Analytics token (cookieless page views, no consent banner needed). Optional; empty = no beacon.
# Read at build time, so rebuild after changing it. Leave empty locally and in CI.
CF_WEB_ANALYTICS_TOKEN=
# Stripe, for Pro (£10 a month or £100 a year). Server only; never NEXT_PUBLIC_. Leave ALL FOUR empty locally, in CI
# and in production until Stripe is set up (docs/launch/LAUNCH.md, "Pro"): the dashboard then says "Pro opens soon"
# and nothing can be bought. Pro opens only when all four are set.
# Secret key (sk_test_... in test mode, sk_live_... live): Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<site>/api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Price ids of "Bolton Vouched Pro": £10 every month, and £100 every year (price_...).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Pro traders' alert emails (job requests, Ask Bolton questions), through Resend's API. Server only; never NEXT_PUBLIC_.
# Production: an API key from Resend (sending access, the ysbdesigns.uk domain). Empty = alert emails are logged as failed.
RESEND_API_KEY=
# Who alert emails come from (a verified Resend domain). Empty = "Bolton Vouched <noreply@ysbdesigns.uk>".
NOTIFY_FROM=
# Local/CI only: alert emails are logged instead of sent. Never set in production.
NOTIFY_EMAIL_STUB=1
