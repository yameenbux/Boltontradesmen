/e2e/.auth/
/playwright-report/

# local Supabase-compatible stack (scripts/local-stack)
/scripts/local-stack/bin/
/scripts/local-stack/logs/
/scripts/local-stack/run/

# OpenNext / Cloudflare Workers trial
/.open-next/
/.wrangler/
.dev.vars*
